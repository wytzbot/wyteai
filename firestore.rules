rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own profile: pro / freeTierBlocked / deviceId are set ONLY
    // by the server (Admin SDK, via /api/verify-payment and
    // /api/register-device), which bypasses these rules. Clients may read
    // their own doc but must NEVER be able to write it directly — if they
    // could, anyone could set pro:true from devtools regardless of payment.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Username -> email lookup, used for login-by-username and reserved
    // client-side at signup. Publicly readable (needed pre-login), but a
    // username can only ever be created once and only by its owner.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // Server-only bookkeeping. No client should ever read or write these —
    // they exist purely for the Admin SDK (which bypasses rules) to
    // enforce device-based free-tier limits, prevent tx_ref reuse, and
    // track AI usage quota.
    match /devices/{deviceId} { allow read, write: if false; }
    match /usedPayments/{txRef} { allow read, write: if false; }
    match /aiUsage/{doc} { allow read, write: if false; }
  }
}
