rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cloud-backup screenshots for Pro users. Owner-only read/write.
    // Note: this does not itself check Pro status (Storage rules can't
    // cheaply read Firestore on every request); the client already only
    // calls this path when proStatus is true, and /api/cleanup-cloud
    // deletes anything expired regardless of plan. If you want this
    // enforced at the rules layer too, add a get() lookup against
    // /databases/(default)/documents/users/$(uid) here.
    match /users/{uid}/projects/{projectId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
